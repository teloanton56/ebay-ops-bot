# --- MODE ---
APP_ENV=development
APP_BASE_URL=http://127.0.0.1:8765
APP_ACCESS_MODE=local
APP_ALLOWED_HOSTS=
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=
APP_SESSION_SECRET=
APP_SESSION_DAYS=30
APP_ENCRYPTION_KEY=
APP_RUNTIME_ENV_PATH=.env
DATABASE_PATH=./ebay_bot.db
DEMO_MODE=true
BACKUP_ENABLED=true
BACKUP_RETENTION=14

# --- EBAY ---
EBAY_ENV=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RUNAME=
EBAY_LOCALE=fr-FR
EBAY_MARKETPLACE_ID=EBAY_FR
EBAY_CURRENCY=EUR

# Verrous : laisser FALSE tant qu'on teste
EBAY_WRITE_ENABLED=false
EBAY_PUBLISH_ENABLED=false

# Business policies / warehouse
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_FULFILLMENT_POLICY_ID=
EBAY_MERCHANT_LOCATION_KEY=main-warehouse
EBAY_LOCATION_COUNTRY=FR
EBAY_LOCATION_POSTAL_CODE=
EBAY_LOCATION_CITY=

# --- RENTABILITE / RISK ENGINE ---
DEFAULT_EBAY_FEE_PERCENT=12.0
DEFAULT_AD_RATE_PERCENT=3.0
DEFAULT_FIXED_FEE=0.35
DEFAULT_RETURN_RESERVE_PERCENT=2.0
MIN_MARGIN_PERCENT=15.0
MIN_PROFIT_EUR=3.0
MIN_STOCK=3
MAX_SHIPPING_DAYS=7
MAX_SUPPLIER_PRICE_JUMP_PERCENT=20.0

# --- AUTOMATION ---
SCHEDULER_ENABLED=false
AUTO_ANALYSIS_ENABLED=true
AUTO_ANALYSIS_MINUTES=60
RADAR_AUTO_ENABLED=true
RADAR_AUTO_HOURS=6
SCHEDULER_SYNC_MINUTES=30

# --- RADAR 360 (facultatif, selon les accès officiels obtenus) ---
GOOGLE_TRENDS_ACCESS=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
YOUTUBE_API_KEY=
META_ACCESS_TOKEN=
AMAZON_SP_API_REFRESH_TOKEN=
ETSY_API_KEY=
DROPXL_API_EMAIL=
DROPXL_API_TOKEN=
DROPXL_ENV=production
PRINTFUL_API_KEY=
PRINTIFY_API_KEY=
GELATO_API_KEY=
