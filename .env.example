# --- APPLICATION ---
APP_ENV=development
APP_BASE_URL=http://127.0.0.1:8765
APP_ACCESS_MODE=local
APP_ALLOWED_HOSTS=
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=
APP_SESSION_SECRET=
APP_SESSION_DAYS=30
APP_ENCRYPTION_KEY=
APP_RUNTIME_ENV_PATH=.env
DATABASE_PATH=./ebay_bot.db
DEMO_MODE=true
BACKUP_ENABLED=true
BACKUP_RETENTION=14

# --- EBAY US / USD ---
EBAY_ENV=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RUNAME=
EBAY_LOCALE=en-US
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_CURRENCY=USD

# Keep both locks disabled until a dry-run has been reviewed.
EBAY_WRITE_ENABLED=false
EBAY_PUBLISH_ENABLED=false

# Business policies and real CJ dispatch locations.
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_FULFILLMENT_POLICY_ID=
EBAY_CJ_US_LOCATION_KEY=
EBAY_CJ_CN_LOCATION_KEY=

# --- EBAY US PROFITABILITY ---
DEFAULT_EBAY_FEE_PERCENT=13.6
DEFAULT_AD_RATE_PERCENT=3.0
EBAY_LOW_ORDER_FEE=0.30
EBAY_STANDARD_ORDER_FEE=0.40
DEFAULT_RETURN_RESERVE_PERCENT=2.0
MIN_MARGIN_PERCENT=20.0
MIN_PROFIT_USD=5.0
MIN_STOCK=10
MAX_SHIPPING_DAYS=7
MAX_SUPPLIER_PRICE_JUMP_PERCENT=20.0

# CJ US warehouse first.
CJ_US_MIN_MARGIN_PERCENT=20.0
CJ_US_MIN_PROFIT_USD=5.0
CJ_US_MIN_STOCK=10
CJ_US_MAX_SHIPPING_DAYS=7

# CJ China fallback only when these stricter thresholds pass.
CJ_CN_MIN_MARGIN_PERCENT=30.0
CJ_CN_MIN_PROFIT_USD=8.0
CJ_CN_MIN_STOCK=20
CJ_CN_MAX_SHIPPING_DAYS=12

# --- AUTOMATION ---
SCHEDULER_ENABLED=false
AUTO_ANALYSIS_ENABLED=true
AUTO_ANALYSIS_MINUTES=60
RADAR_AUTO_ENABLED=true
RADAR_AUTO_HOURS=6
SCHEDULER_SYNC_MINUTES=30

# The CJ API key is encrypted and saved from the application's CJ settings screen.
